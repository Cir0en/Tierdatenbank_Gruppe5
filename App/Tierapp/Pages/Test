<Grid Padding="20" RowDefinitions="Auto, *, Auto, Auto">
    <VerticalStackLayout Grid.Row="0" Spacing="12">
        <Label
            FontAttributes="Bold"
            FontSize="28"
            Text="{translator:Translate DashboardHeader}"
            TextColor="#1A2421" />
        <Label Text="{translator:Translate DashboardUnderHeader}" TextColor="Gray" />
    </VerticalStackLayout>

    <RefreshView Grid.Row="1" Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}" Margin="0,20,0,20">
    <CollectionView ItemsSource="{Binding DashboardItems}">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" 
                             Span="2" 
                             HorizontalItemSpacing="15" 
                             VerticalItemSpacing="15" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame CornerRadius="20" HasShadow="True" Margin="2" HeightRequest="150">
                    <VerticalStackLayout>
                        <Label Text="{Binding Icon}" FontSize="30"/>
                        <Label Text="{Binding Count}" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding Title}" FontSize="12"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </RefreshView>

    <Label Grid.Row="2" Text="{translator:Translate DBQuick}" TextColor="#FF0E0D0D" FontAttributes="Bold" Margin="0,0,0,10"/>
    <HorizontalStackLayout Grid.Row="3" Spacing="10" HorizontalOptions="Center">
        <Button Text="{translator:Translate DBQuickSettings}" Command="{Binding NavigateToSettingsCommand}" BackgroundColor="#FF1A4E2E" TextColor="White" CornerRadius="10" HeightRequest="50"/>
        <Button Text="{translator:Translate DBQuickCollections}" Command="{Binding NavigateToCollectionsCommand}" BackgroundColor="#FF1A4E2E" TextColor="White" CornerRadius="10" HeightRequest="50"/>
        <Button Text="{translator:Translate DBQuickMap}" Command="{Binding NavigateToMapCommand}" BackgroundColor="#FF1A4E2E" TextColor="White" CornerRadius="10" HeightRequest="50"/>
    </HorizontalStackLayout>

    </Grid>


