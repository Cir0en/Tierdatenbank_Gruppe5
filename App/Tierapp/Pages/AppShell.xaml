<Shell
    x:Class="Tierapp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Tierapp"
    BackgroundColor="{StaticResource White}"
    Shell.TabBarBackgroundColor="{StaticResource White}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource Gray500}"
    Shell.TitleColor="{StaticResource Primary}"
    Shell.DisabledColor="{StaticResource Gray300}">

    <ShellContent Route="Login" ContentTemplate="{DataTemplate local:Login}" />

    <TabBar Route ="MainTabs">
        <Tab Title="Dashboard">
            <ShellContent ContentTemplate="{DataTemplate local:Dashboard}" />
        </Tab>
        
        <Tab Title="Sammlungen">
            <ShellContent ContentTemplate="{DataTemplate local:Sammlungen}" />
        </Tab>
    </TabBar>

</Shell>