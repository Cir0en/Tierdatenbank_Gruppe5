<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tierapp.Login">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="12">
            <Label
                Text="Login"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
                
            <Entry x:Name="UsernameEntry" Placeholder="Benutzername" />

            <Entry x:Name="PasswordEntry" Placeholder="Passwort" IsPassword="True" /> 

            <Button Text="Login" Clicked="OnLoginClicked" />

            <Button Text="Ohne Login fortfahren" Clicked="OnContinueWithoutLoginClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>