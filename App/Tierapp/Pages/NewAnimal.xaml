<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tierapp.NewAnimal">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="12">
            <Label
                Text="Neues Tier anlegen"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Entry x:Name="NameEntry" Placeholder="Name des Tieres" />

            <DatePicker x:Name="FindDatePicker" />

            <Entry x:Name="DescriptionEntry" Placeholder="Beschreibung" />

            <Button Text="Tier anlegen" Clicked="OnSubmitClicked" />
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
