# Kopieren nach ".env" (nicht committen) und mit echten Werten befüllen.
# Wird von docker-compose.yml eingelesen.

# --- Backend / Datenbank ---
DB_CONNECTION_STRING=Host=...;Database=neondb;Username=neondb_owner;Password=...;SSL Mode=VerifyFull;Channel Binding=Require;

# --- Clerk (Backend) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_AUTHORITY=https://your-instance.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...

# --- OneSignal (Backend, optional) ---
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# --- Clerk (Frontend, NEXT_PUBLIC_* werden beim Build eingebacken) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- MapTiler (Frontend, NEXT_PUBLIC_*) ---
NEXT_PUBLIC_MAP_API_KEY=

# --- ngrok ---
NGROK_AUTHTOKEN=
# Reservierte ngrok-Domain MIT Schema, z.B. https://dein-name.ngrok-free.dev
# oder eine eigene Custom-Domain - muss stabil bleiben, damit sich u.a. die
# Clerk-Webhook-URL nicht bei jedem Neustart ändert. Das "http"-Flag des
# ngrok-Agents erwartet hier die volle URL inkl. https://.
NGROK_DOMAIN=https://dein-name.ngrok-free.dev
